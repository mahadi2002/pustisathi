APP_NAME=PustiSathi
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_KEY=                     # 32-byte random, base64 — run: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pustisathi
DB_USER=root
DB_PASS=
# DB_MIGRATE_USER=pustisathi_migrate    # separate DDL-capable user in production; falls back to DB_USER locally
# DB_MIGRATE_PASS=

SESSION_LIFETIME_MIN=120
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=3

SUBSCRIPTION_GATEWAY=mock     # mock | dcb
SUBSCRIPTION_PRICE_BDT=2.78

# --- Direct Carrier Billing (fill only once real credentials are issued) ---
DCB_API_BASE=
DCB_CLIENT_ID=
DCB_CLIENT_SECRET=
DCB_SDP_SERVICE_ID=
DCB_WEBHOOK_SECRET=

FOODS_SEARCH_DAILY_CAP_GUEST=10

LOG_LEVEL=info
# ADMIN_IP_ALLOWLIST=
# TRUSTED_PROXIES=
